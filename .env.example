# OpenAI 兼容 API 配置（DeepSeek / 通义千问 / OpenAI / 硅基流动 等）
# 复制本文件为 .env 并填入真实值
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=deepseek-chat

# 可选调优参数
# OPENAI_TIMEOUT=120        # 单次 LLM 请求超时（秒）
# MAX_TOOL_ITERS=6          # 单轮规划中 LLM 最多调用工具的轮数
# MAX_REPAIRS=1             # 测试失败后的自动修复上限
